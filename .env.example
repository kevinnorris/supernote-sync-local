# Required: IP address of the Supernote device on your local network
SUPERNOTE_IP=192.168.1.100

# Required: Device name shown in the Browse & Access UI
SUPERNOTE_NAME=MySupernote

# Port for the Supernote Browse & Access HTTP server (default: 8089)
SUPERNOTE_PORT=8089

# Directories on the device to pull (download) from, comma-separated (default: Note,Document,MyStyle,EXPORT,SCREENSHOT)
SYNC_DIRS=Document,EXPORT

# File extensions to sync, comma-separated without leading dots (default: note,spd,spd-shm,spd-wal,pdf,epub,doc,txt,png,jpg,jpeg,webp)
SYNC_EXTENSIONS=note,spd,spd-shm,spd-wal,pdf,epub,doc,txt,png,jpg,jpeg,webp

# Local directory where synced files are stored (default: supernote/sync)
LOCAL_PATH=supernote/sync

# Path to the SQLite database file (default: supernote/db.sqlite)
DB_PATH=supernote/db.sqlite

# Logging level: debug | info | warn | error (default: info)
LOG_LEVEL=info
